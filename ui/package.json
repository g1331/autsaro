{
  "name": "autosar-config-workbench",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=11 <12"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "lint": "eslint src tests vite.config.ts vitest.config.ts",
    "tauri": "cd .. && tauri",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --maxWorkers=2",
    "ipc:check": "cd .. && cargo test --locked --profile dev -p autosar-config-desktop --lib ipc_bindings_match_rust && cargo test --locked --profile dev -p autosar-config-desktop --features native-webdriver --lib ipc_bindings_match_rust",
    "ipc:generate": "cd .. && cargo test --locked --profile dev -p autosar-config-desktop --lib ipc_bindings_match_rust -- --ignored && cargo test --locked --profile dev -p autosar-config-desktop --features native-webdriver --lib ipc_bindings_match_rust -- --ignored"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.3",
    "@tauri-apps/plugin-dialog": "^2.8.2",
    "cmdk": "^1.1.1",
    "i18next": "^26.4.3",
    "lucide-react": "^1.55.0",
    "radix-ui": "^1.8.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^17.0.16"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tauri-apps/cli": "2.12.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "^8.3.4",
    "vitest": "5.0.5"
  }
}
