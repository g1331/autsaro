// WebKitGTK 2.52.6 x86_64. evidence.mjs verifies both ELF identities and
// instruction bytes before substituting paths/PIDs and loading these uprobes.
// Only session-owned processes are observed. No target function is called.
// Source/ELF boundary validation and the original live identity proof:
// https://github.com/g1331/autsaro/issues/311#issuecomment-6258214138
// https://github.com/g1331/autsaro/issues/311#issuecomment-6258495196
// The explicit & 127 keeps bpftrace 0.20's byte-sized dynamic buf length
// within its allocated buffer; an unrestricted byte bound reaches 255.
BEGIN
{
  OWNERS
  printf("{\"stage\":\"ready\",\"monoNs\":%llu}\n", nsecs);
}

tracepoint:sched:sched_process_fork /@owned[pid]/
{
  @owned[args->child_pid] = 1;
}

tracepoint:sched:sched_process_exit /@owned[tid]/
{
  delete(@owned[tid]);
}

// SessionHost outgoing message, selected response handler, then the script
// result callback's parseJSON and reconstruction call sites, respectively.
uprobe:DRIVER:0x4537b /@owned[pid]/
{
  $bp = reg("bp");
  $sequence = *(uint64 *)uptr($bp - 0x80);
  $impl = *(uint64 *)uptr($bp - 0x40);
  $length = *(uint32 *)uptr($impl + 4);
  $data = *(uint64 *)uptr($impl + 8);
  $eight = (*(uint32 *)uptr($impl + 16) & 4) != 0;
  $bytes = $length * (2 - $eight);
  if (!$sequence || !$impl || !$data || !$length) {
    printf("{\"stage\":\"probe-error\",\"boundary\":\"driver-send\",\"pid\":%d,\"monoNs\":%llu}\n", pid, nsecs);
  }
  printf("{\"stage\":\"driver-send\",\"pid\":%d,\"tid\":%d,\"monoNs\":%llu,\"sequence\":%llu,\"codeUnits\":%u,\"is8Bit\":%u,\"prefixHex\":\"%rh\"}\n",
    pid, tid, nsecs, $sequence, $length, $eight, buf(uptr($data), ($bytes < 127 ? $bytes : 127) & 127));
  if ($bytes > 127) {
    printf("{\"stage\":\"driver-send-continuation\",\"pid\":%d,\"monoNs\":%llu,\"sequence\":%llu,\"byteOffset\":127,\"prefixHex\":\"%rh\"}\n",
      pid, nsecs, $sequence, buf(uptr($data + 127), (($bytes - 127) < 127 ? ($bytes - 127) : 127) & 127));
  }
  if (!$eight && $bytes > 254) {
    printf("{\"stage\":\"driver-send-continuation\",\"pid\":%d,\"monoNs\":%llu,\"sequence\":%llu,\"byteOffset\":254,\"prefixHex\":\"%rh\"}\n",
      pid, nsecs, $sequence, buf(uptr($data + 254), (($bytes - 254) < 127 ? ($bytes - 254) : 127) & 127));
  }
  if (!$eight && $bytes > 381) {
    printf("{\"stage\":\"driver-send-continuation\",\"pid\":%d,\"monoNs\":%llu,\"sequence\":%llu,\"byteOffset\":381,\"prefixHex\":\"%rh\"}\n",
      pid, nsecs, $sequence, buf(uptr($data + 381), (($bytes - 381) < 127 ? ($bytes - 381) : 127) & 127));
  }
}

uprobe:DRIVER:0x4597f /@owned[pid]/
{
  $handler = *(uint64 *)uptr(reg("bp") - 0x50);
  $sequence = reg("r12") & 0xffffffff;
  @sequence[pid, $handler] = $sequence;
  if (!$handler || !$sequence) {
    printf("{\"stage\":\"probe-error\",\"boundary\":\"driver-dispatch\",\"pid\":%d,\"monoNs\":%llu}\n", pid, nsecs);
  }
  printf("{\"stage\":\"driver-dispatch\",\"pid\":%d,\"tid\":%d,\"monoNs\":%llu,\"sequence\":%llu,\"handler\":%llu}\n",
    pid, tid, nsecs, $sequence, $handler);
}

uprobe:DRIVER:0x3bf98 /@owned[pid]/
{
  $handler = reg("bx");
  $packed = reg("dx");
  $length = $packed & 0xffffffff;
  $eight = ($packed >> 32) != 0;
  printf("{\"stage\":\"driver-parse\",\"pid\":%d,\"tid\":%d,\"monoNs\":%llu,\"sequence\":%llu,\"handler\":%llu,\"codeUnits\":%llu,\"is8Bit\":%u,\"bufferByteLength\":%llu}\n",
    pid, tid, nsecs, @sequence[pid, $handler], $handler, $length, $eight, $length * (2 - $eight));
}

uprobe:DRIVER:0x3bfce /@owned[pid]/
{
  $handler = reg("bx");
  $root = *(uint64 *)uptr(reg("dx"));
  if (!$root) {
    printf("{\"stage\":\"probe-error\",\"boundary\":\"driver-reconstruct\",\"pid\":%d,\"monoNs\":%llu}\n", pid, nsecs);
  }
  printf("{\"stage\":\"driver-reconstruct\",\"pid\":%d,\"tid\":%d,\"monoNs\":%llu,\"sequence\":%llu,\"handler\":%llu,\"rootKind\":%u}\n",
    pid, tid, nsecs, @sequence[pid, $handler], $handler, *(uint8 *)uptr($root + 16));
  delete(@sequence[pid, $handler]);
}

// Generated Automation dispatch and its UIProcess response callback.
uprobe:WEBKIT:0x71e1f0 /@owned[pid]/
{
  printf("{\"stage\":\"ui-command\",\"pid\":%d,\"tid\":%d,\"monoNs\":%llu,\"sequence\":%llu}\n",
    pid, tid, nsecs, reg("si"));
}

uprobe:WEBKIT:0x7272a0 /@owned[pid]/
{
  printf("{\"stage\":\"ui-response\",\"pid\":%d,\"tid\":%d,\"monoNs\":%llu,\"sequence\":%llu}\n",
    pid, tid, nsecs, *(uint64 *)uptr(reg("di") + 0x10));
}

// WebProcess proxy entry, JavaScript call site and frame/callback response.
uprobe:WEBKIT:0x1004940 /@owned[pid]/
{
  @entry[pid, tid] = nsecs;
  $vector = reg("r9");
  $data = *(uint64 *)uptr($vector);
  $impl = *(uint64 *)uptr($data);
  $length = *(uint32 *)uptr($impl + 4);
  $text = *(uint64 *)uptr($impl + 8);
  $eight = (*(uint32 *)uptr($impl + 16) & 4) != 0;
  $bytes = $length * (2 - $eight);
  printf("{\"stage\":\"web-command\",\"pid\":%d,\"tid\":%d,\"monoNs\":%llu,\"commandToken\":%llu,\"prefixHex\":\"%rh\",\"is8Bit\":%u}\n",
    pid, tid, nsecs, @entry[pid, tid], buf(uptr($text), ($bytes < 127 ? $bytes : 127) & 127), $eight);
}

uprobe:WEBKIT:0x1004fc5 /@owned[pid]/
{
  $frame = *(uint64 *)uptr(reg("bp") - 0x108);
  $callback = *(uint64 *)uptr(reg("bp") - 0x118);
  @callback[pid, $frame, $callback] = @entry[pid, tid];
  printf("{\"stage\":\"web-javascript\",\"pid\":%d,\"tid\":%d,\"monoNs\":%llu,\"frame\":%llu,\"callback\":%llu,\"commandToken\":%llu}\n",
    pid, tid, nsecs, $frame, $callback, @entry[pid, tid]);
  delete(@entry[pid, tid]);
}

uprobe:WEBKIT:0x1005cf0 /@owned[pid]/
{
  $impl = *(uint64 *)uptr(reg("cx"));
  $length = $impl ? *(uint32 *)uptr($impl + 4) : 0;
  $eight = $impl ? (*(uint32 *)uptr($impl + 16) & 4) != 0 : 1;
  printf("{\"stage\":\"web-response\",\"pid\":%d,\"tid\":%d,\"monoNs\":%llu,\"frame\":%llu,\"callback\":%llu,\"commandToken\":%llu,\"codeUnits\":%u,\"is8Bit\":%u}\n",
    pid, tid, nsecs, reg("si"), reg("dx"), @callback[pid, reg("si"), reg("dx")], $length, $eight);
  delete(@callback[pid, reg("si"), reg("dx")]);
}

END
{
  clear(@owned);
  clear(@sequence);
  clear(@entry);
  clear(@callback);
}
