<?xml version='1.0' encoding='UTF-8'?>
<AUTOSAR xmlns="http://autosar.org/schema/r4.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://autosar.org/schema/r4.0 AUTOSAR_00053.xsd">
  <AR-PACKAGES>
    <AR-PACKAGE>
      <SHORT-NAME>Extract</SHORT-NAME>
      <ELEMENTS>
        <ECU-INSTANCE>
          <SHORT-NAME>ReferenceEcu</SHORT-NAME>
          <COMM-CONTROLLERS>
            <CAN-COMMUNICATION-CONTROLLER>
              <SHORT-NAME>CanController</SHORT-NAME>
            </CAN-COMMUNICATION-CONTROLLER>
          </COMM-CONTROLLERS>
          <CONNECTORS>
            <CAN-COMMUNICATION-CONNECTOR>
              <SHORT-NAME>CanConnector</SHORT-NAME>
              <COMM-CONTROLLER-REF DEST="CAN-COMMUNICATION-CONTROLLER">/Extract/ReferenceEcu/CanController</COMM-CONTROLLER-REF>
              <ECU-COMM-PORT-INSTANCES>
                <FRAME-PORT>
                  <SHORT-NAME>RxValueFramePort</SHORT-NAME>
                  <COMMUNICATION-DIRECTION>IN</COMMUNICATION-DIRECTION>
                </FRAME-PORT>
                <I-PDU-PORT>
                  <SHORT-NAME>RxValuePduPort</SHORT-NAME>
                  <COMMUNICATION-DIRECTION>IN</COMMUNICATION-DIRECTION>
                </I-PDU-PORT>
                <I-SIGNAL-PORT>
                  <SHORT-NAME>RxValueSignalPort</SHORT-NAME>
                  <COMMUNICATION-DIRECTION>IN</COMMUNICATION-DIRECTION>
                  <FIRST-TIMEOUT>0</FIRST-TIMEOUT>
                  <TIMEOUT>0.03</TIMEOUT>
                </I-SIGNAL-PORT>
                <FRAME-PORT>
                  <SHORT-NAME>TxValueFramePort</SHORT-NAME>
                  <COMMUNICATION-DIRECTION>OUT</COMMUNICATION-DIRECTION>
                </FRAME-PORT>
                <I-PDU-PORT>
                  <SHORT-NAME>TxValuePduPort</SHORT-NAME>
                  <COMMUNICATION-DIRECTION>OUT</COMMUNICATION-DIRECTION>
                </I-PDU-PORT>
                <I-SIGNAL-PORT>
                  <SHORT-NAME>TxValueSignalPort</SHORT-NAME>
                  <COMMUNICATION-DIRECTION>OUT</COMMUNICATION-DIRECTION>
                </I-SIGNAL-PORT>
                <FRAME-PORT>
                  <SHORT-NAME>DiagRequestFramePort</SHORT-NAME>
                  <COMMUNICATION-DIRECTION>IN</COMMUNICATION-DIRECTION>
                </FRAME-PORT>
                <I-PDU-PORT>
                  <SHORT-NAME>DiagRequestPduPort</SHORT-NAME>
                  <COMMUNICATION-DIRECTION>IN</COMMUNICATION-DIRECTION>
                </I-PDU-PORT>
                <FRAME-PORT>
                  <SHORT-NAME>DiagResponseFramePort</SHORT-NAME>
                  <COMMUNICATION-DIRECTION>OUT</COMMUNICATION-DIRECTION>
                </FRAME-PORT>
                <I-PDU-PORT>
                  <SHORT-NAME>DiagResponsePduPort</SHORT-NAME>
                  <COMMUNICATION-DIRECTION>OUT</COMMUNICATION-DIRECTION>
                </I-PDU-PORT>
              </ECU-COMM-PORT-INSTANCES>
            </CAN-COMMUNICATION-CONNECTOR>
          </CONNECTORS>
        </ECU-INSTANCE>
        <CAN-CLUSTER>
          <SHORT-NAME>ReferenceCan</SHORT-NAME>
          <CAN-CLUSTER-VARIANTS>
            <CAN-CLUSTER-CONDITIONAL>
              <BAUDRATE>500000</BAUDRATE>
              <PHYSICAL-CHANNELS>
                <CAN-PHYSICAL-CHANNEL>
                  <SHORT-NAME>Channel</SHORT-NAME>
                  <COMM-CONNECTORS>
                    <COMMUNICATION-CONNECTOR-REF-CONDITIONAL>
                      <COMMUNICATION-CONNECTOR-REF DEST="CAN-COMMUNICATION-CONNECTOR">/Extract/ReferenceEcu/CanConnector</COMMUNICATION-CONNECTOR-REF>
                    </COMMUNICATION-CONNECTOR-REF-CONDITIONAL>
                  </COMM-CONNECTORS>
                  <FRAME-TRIGGERINGS>
                    <CAN-FRAME-TRIGGERING>
                      <SHORT-NAME>RxValueTrigger</SHORT-NAME>
                      <FRAME-PORT-REFS>
                        <FRAME-PORT-REF DEST="FRAME-PORT">/Extract/ReferenceEcu/CanConnector/RxValueFramePort</FRAME-PORT-REF>
                      </FRAME-PORT-REFS>
                      <FRAME-REF DEST="CAN-FRAME">/Extract/RxValueFrame</FRAME-REF>
                      <PDU-TRIGGERINGS>
                        <PDU-TRIGGERING-REF-CONDITIONAL>
                          <PDU-TRIGGERING-REF DEST="PDU-TRIGGERING">/Extract/ReferenceCan/Channel/RxValuePduTrigger</PDU-TRIGGERING-REF>
                        </PDU-TRIGGERING-REF-CONDITIONAL>
                      </PDU-TRIGGERINGS>
                      <CAN-ADDRESSING-MODE>STANDARD</CAN-ADDRESSING-MODE>
                      <CAN-FD-FRAME-SUPPORT>false</CAN-FD-FRAME-SUPPORT>
                      <IDENTIFIER>800</IDENTIFIER>
                    </CAN-FRAME-TRIGGERING>
                    <CAN-FRAME-TRIGGERING>
                      <SHORT-NAME>TxValueTrigger</SHORT-NAME>
                      <FRAME-PORT-REFS>
                        <FRAME-PORT-REF DEST="FRAME-PORT">/Extract/ReferenceEcu/CanConnector/TxValueFramePort</FRAME-PORT-REF>
                      </FRAME-PORT-REFS>
                      <FRAME-REF DEST="CAN-FRAME">/Extract/TxValueFrame</FRAME-REF>
                      <PDU-TRIGGERINGS>
                        <PDU-TRIGGERING-REF-CONDITIONAL>
                          <PDU-TRIGGERING-REF DEST="PDU-TRIGGERING">/Extract/ReferenceCan/Channel/TxValuePduTrigger</PDU-TRIGGERING-REF>
                        </PDU-TRIGGERING-REF-CONDITIONAL>
                      </PDU-TRIGGERINGS>
                      <CAN-ADDRESSING-MODE>STANDARD</CAN-ADDRESSING-MODE>
                      <CAN-FD-FRAME-SUPPORT>false</CAN-FD-FRAME-SUPPORT>
                      <IDENTIFIER>801</IDENTIFIER>
                    </CAN-FRAME-TRIGGERING>
                    <CAN-FRAME-TRIGGERING>
                      <SHORT-NAME>DiagRequestTrigger</SHORT-NAME>
                      <FRAME-PORT-REFS>
                        <FRAME-PORT-REF DEST="FRAME-PORT">/Extract/ReferenceEcu/CanConnector/DiagRequestFramePort</FRAME-PORT-REF>
                      </FRAME-PORT-REFS>
                      <FRAME-REF DEST="CAN-FRAME">/Extract/DiagRequestFrame</FRAME-REF>
                      <PDU-TRIGGERINGS>
                        <PDU-TRIGGERING-REF-CONDITIONAL>
                          <PDU-TRIGGERING-REF DEST="PDU-TRIGGERING">/Extract/ReferenceCan/Channel/DiagRequestPduTrigger</PDU-TRIGGERING-REF>
                        </PDU-TRIGGERING-REF-CONDITIONAL>
                      </PDU-TRIGGERINGS>
                      <CAN-ADDRESSING-MODE>STANDARD</CAN-ADDRESSING-MODE>
                      <CAN-FD-FRAME-SUPPORT>false</CAN-FD-FRAME-SUPPORT>
                      <IDENTIFIER>1792</IDENTIFIER>
                    </CAN-FRAME-TRIGGERING>
                    <CAN-FRAME-TRIGGERING>
                      <SHORT-NAME>DiagResponseTrigger</SHORT-NAME>
                      <FRAME-PORT-REFS>
                        <FRAME-PORT-REF DEST="FRAME-PORT">/Extract/ReferenceEcu/CanConnector/DiagResponseFramePort</FRAME-PORT-REF>
                      </FRAME-PORT-REFS>
                      <FRAME-REF DEST="CAN-FRAME">/Extract/DiagResponseFrame</FRAME-REF>
                      <PDU-TRIGGERINGS>
                        <PDU-TRIGGERING-REF-CONDITIONAL>
                          <PDU-TRIGGERING-REF DEST="PDU-TRIGGERING">/Extract/ReferenceCan/Channel/DiagResponsePduTrigger</PDU-TRIGGERING-REF>
                        </PDU-TRIGGERING-REF-CONDITIONAL>
                      </PDU-TRIGGERINGS>
                      <CAN-ADDRESSING-MODE>STANDARD</CAN-ADDRESSING-MODE>
                      <CAN-FD-FRAME-SUPPORT>false</CAN-FD-FRAME-SUPPORT>
                      <IDENTIFIER>1800</IDENTIFIER>
                    </CAN-FRAME-TRIGGERING>
                  </FRAME-TRIGGERINGS>
                  <I-SIGNAL-TRIGGERINGS>
                    <I-SIGNAL-TRIGGERING>
                      <SHORT-NAME>RxValueSignalTrigger</SHORT-NAME>
                      <I-SIGNAL-PORT-REFS>
                        <I-SIGNAL-PORT-REF DEST="I-SIGNAL-PORT">/Extract/ReferenceEcu/CanConnector/RxValueSignalPort</I-SIGNAL-PORT-REF>
                      </I-SIGNAL-PORT-REFS>
                      <I-SIGNAL-REF DEST="I-SIGNAL">/Extract/RxValueSignal</I-SIGNAL-REF>
                    </I-SIGNAL-TRIGGERING>
                    <I-SIGNAL-TRIGGERING>
                      <SHORT-NAME>TxValueSignalTrigger</SHORT-NAME>
                      <I-SIGNAL-PORT-REFS>
                        <I-SIGNAL-PORT-REF DEST="I-SIGNAL-PORT">/Extract/ReferenceEcu/CanConnector/TxValueSignalPort</I-SIGNAL-PORT-REF>
                      </I-SIGNAL-PORT-REFS>
                      <I-SIGNAL-REF DEST="I-SIGNAL">/Extract/TxValueSignal</I-SIGNAL-REF>
                    </I-SIGNAL-TRIGGERING>
                  </I-SIGNAL-TRIGGERINGS>
                  <PDU-TRIGGERINGS>
                    <PDU-TRIGGERING>
                      <SHORT-NAME>RxValuePduTrigger</SHORT-NAME>
                      <I-PDU-PORT-REFS>
                        <I-PDU-PORT-REF DEST="I-PDU-PORT">/Extract/ReferenceEcu/CanConnector/RxValuePduPort</I-PDU-PORT-REF>
                      </I-PDU-PORT-REFS>
                      <I-PDU-REF DEST="I-SIGNAL-I-PDU">/Extract/RxValuePdu</I-PDU-REF>
                      <I-SIGNAL-TRIGGERINGS>
                        <I-SIGNAL-TRIGGERING-REF-CONDITIONAL>
                          <I-SIGNAL-TRIGGERING-REF DEST="I-SIGNAL-TRIGGERING">/Extract/ReferenceCan/Channel/RxValueSignalTrigger</I-SIGNAL-TRIGGERING-REF>
                        </I-SIGNAL-TRIGGERING-REF-CONDITIONAL>
                      </I-SIGNAL-TRIGGERINGS>
                    </PDU-TRIGGERING>
                    <PDU-TRIGGERING>
                      <SHORT-NAME>TxValuePduTrigger</SHORT-NAME>
                      <I-PDU-PORT-REFS>
                        <I-PDU-PORT-REF DEST="I-PDU-PORT">/Extract/ReferenceEcu/CanConnector/TxValuePduPort</I-PDU-PORT-REF>
                      </I-PDU-PORT-REFS>
                      <I-PDU-REF DEST="I-SIGNAL-I-PDU">/Extract/TxValuePdu</I-PDU-REF>
                      <I-SIGNAL-TRIGGERINGS>
                        <I-SIGNAL-TRIGGERING-REF-CONDITIONAL>
                          <I-SIGNAL-TRIGGERING-REF DEST="I-SIGNAL-TRIGGERING">/Extract/ReferenceCan/Channel/TxValueSignalTrigger</I-SIGNAL-TRIGGERING-REF>
                        </I-SIGNAL-TRIGGERING-REF-CONDITIONAL>
                      </I-SIGNAL-TRIGGERINGS>
                    </PDU-TRIGGERING>
                    <PDU-TRIGGERING>
                      <SHORT-NAME>DiagRequestPduTrigger</SHORT-NAME>
                      <I-PDU-PORT-REFS>
                        <I-PDU-PORT-REF DEST="I-PDU-PORT">/Extract/ReferenceEcu/CanConnector/DiagRequestPduPort</I-PDU-PORT-REF>
                      </I-PDU-PORT-REFS>
                      <I-PDU-REF DEST="N-PDU">/Extract/DiagRequestPdu</I-PDU-REF>
                    </PDU-TRIGGERING>
                    <PDU-TRIGGERING>
                      <SHORT-NAME>DiagResponsePduTrigger</SHORT-NAME>
                      <I-PDU-PORT-REFS>
                        <I-PDU-PORT-REF DEST="I-PDU-PORT">/Extract/ReferenceEcu/CanConnector/DiagResponsePduPort</I-PDU-PORT-REF>
                      </I-PDU-PORT-REFS>
                      <I-PDU-REF DEST="N-PDU">/Extract/DiagResponsePdu</I-PDU-REF>
                    </PDU-TRIGGERING>
                  </PDU-TRIGGERINGS>
                </CAN-PHYSICAL-CHANNEL>
              </PHYSICAL-CHANNELS>
            </CAN-CLUSTER-CONDITIONAL>
          </CAN-CLUSTER-VARIANTS>
        </CAN-CLUSTER>
        <CAN-FRAME>
          <SHORT-NAME>RxValueFrame</SHORT-NAME>
          <FRAME-LENGTH>4</FRAME-LENGTH>
          <PDU-TO-FRAME-MAPPINGS>
            <PDU-TO-FRAME-MAPPING>
              <SHORT-NAME>RxValuePduMap</SHORT-NAME>
              <PACKING-BYTE-ORDER>MOST-SIGNIFICANT-BYTE-LAST</PACKING-BYTE-ORDER>
              <PDU-REF DEST="I-SIGNAL-I-PDU">/Extract/RxValuePdu</PDU-REF>
              <START-POSITION>0</START-POSITION>
            </PDU-TO-FRAME-MAPPING>
          </PDU-TO-FRAME-MAPPINGS>
        </CAN-FRAME>
        <I-SIGNAL-I-PDU>
          <SHORT-NAME>RxValuePdu</SHORT-NAME>
          <LENGTH>4</LENGTH>
          <I-SIGNAL-TO-PDU-MAPPINGS>
            <I-SIGNAL-TO-I-PDU-MAPPING>
              <SHORT-NAME>RxValueMap</SHORT-NAME>
              <I-SIGNAL-REF DEST="I-SIGNAL">/Extract/RxValueSignal</I-SIGNAL-REF>
              <PACKING-BYTE-ORDER>MOST-SIGNIFICANT-BYTE-LAST</PACKING-BYTE-ORDER>
              <START-POSITION>0</START-POSITION>
              <TRANSFER-PROPERTY>PENDING</TRANSFER-PROPERTY>
            </I-SIGNAL-TO-I-PDU-MAPPING>
          </I-SIGNAL-TO-PDU-MAPPINGS>
        </I-SIGNAL-I-PDU>
        <I-SIGNAL>
          <SHORT-NAME>RxValueSignal</SHORT-NAME>
          <DATA-TYPE-POLICY>OVERRIDE</DATA-TYPE-POLICY>
          <INIT-VALUE>
            <NUMERICAL-VALUE-SPECIFICATION>
              <VALUE>0</VALUE>
            </NUMERICAL-VALUE-SPECIFICATION>
          </INIT-VALUE>
          <LENGTH>32</LENGTH>
          <NETWORK-REPRESENTATION-PROPS>
            <SW-DATA-DEF-PROPS-VARIANTS>
              <SW-DATA-DEF-PROPS-CONDITIONAL>
                <BASE-TYPE-REF DEST="SW-BASE-TYPE">/Types/Base_uint32</BASE-TYPE-REF>
              </SW-DATA-DEF-PROPS-CONDITIONAL>
            </SW-DATA-DEF-PROPS-VARIANTS>
          </NETWORK-REPRESENTATION-PROPS>
          <SYSTEM-SIGNAL-REF DEST="SYSTEM-SIGNAL">/Extract/RxValueSystemSignal</SYSTEM-SIGNAL-REF>
        </I-SIGNAL>
        <SYSTEM-SIGNAL>
          <SHORT-NAME>RxValueSystemSignal</SHORT-NAME>
        </SYSTEM-SIGNAL>
        <CAN-FRAME>
          <SHORT-NAME>TxValueFrame</SHORT-NAME>
          <FRAME-LENGTH>4</FRAME-LENGTH>
          <PDU-TO-FRAME-MAPPINGS>
            <PDU-TO-FRAME-MAPPING>
              <SHORT-NAME>TxValuePduMap</SHORT-NAME>
              <PACKING-BYTE-ORDER>MOST-SIGNIFICANT-BYTE-LAST</PACKING-BYTE-ORDER>
              <PDU-REF DEST="I-SIGNAL-I-PDU">/Extract/TxValuePdu</PDU-REF>
              <START-POSITION>0</START-POSITION>
            </PDU-TO-FRAME-MAPPING>
          </PDU-TO-FRAME-MAPPINGS>
        </CAN-FRAME>
        <I-SIGNAL-I-PDU>
          <SHORT-NAME>TxValuePdu</SHORT-NAME>
          <LENGTH>4</LENGTH>
          <I-SIGNAL-TO-PDU-MAPPINGS>
            <I-SIGNAL-TO-I-PDU-MAPPING>
              <SHORT-NAME>TxValueMap</SHORT-NAME>
              <I-SIGNAL-REF DEST="I-SIGNAL">/Extract/TxValueSignal</I-SIGNAL-REF>
              <PACKING-BYTE-ORDER>MOST-SIGNIFICANT-BYTE-LAST</PACKING-BYTE-ORDER>
              <START-POSITION>0</START-POSITION>
              <TRANSFER-PROPERTY>PENDING</TRANSFER-PROPERTY>
            </I-SIGNAL-TO-I-PDU-MAPPING>
          </I-SIGNAL-TO-PDU-MAPPINGS>
        </I-SIGNAL-I-PDU>
        <I-SIGNAL>
          <SHORT-NAME>TxValueSignal</SHORT-NAME>
          <DATA-TYPE-POLICY>OVERRIDE</DATA-TYPE-POLICY>
          <INIT-VALUE>
            <NUMERICAL-VALUE-SPECIFICATION>
              <VALUE>0</VALUE>
            </NUMERICAL-VALUE-SPECIFICATION>
          </INIT-VALUE>
          <LENGTH>32</LENGTH>
          <NETWORK-REPRESENTATION-PROPS>
            <SW-DATA-DEF-PROPS-VARIANTS>
              <SW-DATA-DEF-PROPS-CONDITIONAL>
                <BASE-TYPE-REF DEST="SW-BASE-TYPE">/Types/Base_uint32</BASE-TYPE-REF>
              </SW-DATA-DEF-PROPS-CONDITIONAL>
            </SW-DATA-DEF-PROPS-VARIANTS>
          </NETWORK-REPRESENTATION-PROPS>
          <SYSTEM-SIGNAL-REF DEST="SYSTEM-SIGNAL">/Extract/TxValueSystemSignal</SYSTEM-SIGNAL-REF>
        </I-SIGNAL>
        <SYSTEM-SIGNAL>
          <SHORT-NAME>TxValueSystemSignal</SHORT-NAME>
        </SYSTEM-SIGNAL>
        <CAN-FRAME>
          <SHORT-NAME>DiagRequestFrame</SHORT-NAME>
          <FRAME-LENGTH>8</FRAME-LENGTH>
          <PDU-TO-FRAME-MAPPINGS>
            <PDU-TO-FRAME-MAPPING>
              <SHORT-NAME>DiagRequestPduMap</SHORT-NAME>
              <PACKING-BYTE-ORDER>MOST-SIGNIFICANT-BYTE-LAST</PACKING-BYTE-ORDER>
              <PDU-REF DEST="N-PDU">/Extract/DiagRequestPdu</PDU-REF>
              <START-POSITION>0</START-POSITION>
            </PDU-TO-FRAME-MAPPING>
          </PDU-TO-FRAME-MAPPINGS>
        </CAN-FRAME>
        <N-PDU>
          <SHORT-NAME>DiagRequestPdu</SHORT-NAME>
          <LENGTH>8</LENGTH>
        </N-PDU>
        <CAN-FRAME>
          <SHORT-NAME>DiagResponseFrame</SHORT-NAME>
          <FRAME-LENGTH>8</FRAME-LENGTH>
          <PDU-TO-FRAME-MAPPINGS>
            <PDU-TO-FRAME-MAPPING>
              <SHORT-NAME>DiagResponsePduMap</SHORT-NAME>
              <PACKING-BYTE-ORDER>MOST-SIGNIFICANT-BYTE-LAST</PACKING-BYTE-ORDER>
              <PDU-REF DEST="N-PDU">/Extract/DiagResponsePdu</PDU-REF>
              <START-POSITION>0</START-POSITION>
            </PDU-TO-FRAME-MAPPING>
          </PDU-TO-FRAME-MAPPINGS>
        </CAN-FRAME>
        <N-PDU>
          <SHORT-NAME>DiagResponsePdu</SHORT-NAME>
          <LENGTH>8</LENGTH>
        </N-PDU>
        <SYSTEM>
          <SHORT-NAME>ReferenceExtract</SHORT-NAME>
          <CATEGORY>ECU_EXTRACT</CATEGORY>
          <ECU-EXTRACT-VERSION>1.0.0</ECU-EXTRACT-VERSION>
          <FIBEX-ELEMENTS>
            <FIBEX-ELEMENT-REF-CONDITIONAL>
              <FIBEX-ELEMENT-REF DEST="ECU-INSTANCE">/Extract/ReferenceEcu</FIBEX-ELEMENT-REF>
            </FIBEX-ELEMENT-REF-CONDITIONAL>
            <FIBEX-ELEMENT-REF-CONDITIONAL>
              <FIBEX-ELEMENT-REF DEST="CAN-CLUSTER">/Extract/ReferenceCan</FIBEX-ELEMENT-REF>
            </FIBEX-ELEMENT-REF-CONDITIONAL>
          </FIBEX-ELEMENTS>
          <MAPPINGS>
            <SYSTEM-MAPPING>
              <SHORT-NAME>Mapping</SHORT-NAME>
              <DATA-MAPPINGS>
                <SENDER-RECEIVER-TO-SIGNAL-MAPPING>
                  <COMMUNICATION-DIRECTION>IN</COMMUNICATION-DIRECTION>
                  <DATA-ELEMENT-IREF>
                    <CONTEXT-COMPONENT-REF DEST="SW-COMPONENT-PROTOTYPE">/Application/ReferenceComposition/EchoApplication</CONTEXT-COMPONENT-REF>
                    <CONTEXT-COMPOSITION-REF DEST="ROOT-SW-COMPOSITION-PROTOTYPE">/Extract/ReferenceExtract/RootComposition</CONTEXT-COMPOSITION-REF>
                    <CONTEXT-PORT-REF DEST="R-PORT-PROTOTYPE">/Application/EchoApplication/RxValue</CONTEXT-PORT-REF>
                    <TARGET-DATA-PROTOTYPE-REF DEST="VARIABLE-DATA-PROTOTYPE">/Types/ValueInterface/Value</TARGET-DATA-PROTOTYPE-REF>
                  </DATA-ELEMENT-IREF>
                  <SYSTEM-SIGNAL-REF DEST="SYSTEM-SIGNAL">/Extract/RxValueSystemSignal</SYSTEM-SIGNAL-REF>
                </SENDER-RECEIVER-TO-SIGNAL-MAPPING>
                <SENDER-RECEIVER-TO-SIGNAL-MAPPING>
                  <COMMUNICATION-DIRECTION>OUT</COMMUNICATION-DIRECTION>
                  <DATA-ELEMENT-IREF>
                    <CONTEXT-COMPONENT-REF DEST="SW-COMPONENT-PROTOTYPE">/Application/ReferenceComposition/EchoApplication</CONTEXT-COMPONENT-REF>
                    <CONTEXT-COMPOSITION-REF DEST="ROOT-SW-COMPOSITION-PROTOTYPE">/Extract/ReferenceExtract/RootComposition</CONTEXT-COMPOSITION-REF>
                    <CONTEXT-PORT-REF DEST="P-PORT-PROTOTYPE">/Application/EchoApplication/TxValue</CONTEXT-PORT-REF>
                    <TARGET-DATA-PROTOTYPE-REF DEST="VARIABLE-DATA-PROTOTYPE">/Types/ValueInterface/Value</TARGET-DATA-PROTOTYPE-REF>
                  </DATA-ELEMENT-IREF>
                  <SYSTEM-SIGNAL-REF DEST="SYSTEM-SIGNAL">/Extract/TxValueSystemSignal</SYSTEM-SIGNAL-REF>
                </SENDER-RECEIVER-TO-SIGNAL-MAPPING>
              </DATA-MAPPINGS>
              <SW-MAPPINGS>
                <SWC-TO-ECU-MAPPING>
                  <SHORT-NAME>EchoToEcu</SHORT-NAME>
                  <COMPONENT-IREFS>
                    <COMPONENT-IREF>
                      <CONTEXT-COMPOSITION-REF DEST="ROOT-SW-COMPOSITION-PROTOTYPE">/Extract/ReferenceExtract/RootComposition</CONTEXT-COMPOSITION-REF>
                      <TARGET-COMPONENT-REF DEST="SW-COMPONENT-PROTOTYPE">/Application/ReferenceComposition/EchoApplication</TARGET-COMPONENT-REF>
                    </COMPONENT-IREF>
                  <COMPONENT-IREF><CONTEXT-COMPOSITION-REF DEST="ROOT-SW-COMPOSITION-PROTOTYPE">/Extract/ReferenceExtract/RootComposition</CONTEXT-COMPOSITION-REF><TARGET-COMPONENT-REF DEST="SW-COMPONENT-PROTOTYPE">/Application/ReferenceComposition/DcmService</TARGET-COMPONENT-REF></COMPONENT-IREF></COMPONENT-IREFS>
                  <ECU-INSTANCE-REF DEST="ECU-INSTANCE">/Extract/ReferenceEcu</ECU-INSTANCE-REF>
                </SWC-TO-ECU-MAPPING>
              </SW-MAPPINGS>
            </SYSTEM-MAPPING>
          </MAPPINGS>
          <ROOT-SOFTWARE-COMPOSITIONS>
            <ROOT-SW-COMPOSITION-PROTOTYPE>
              <SHORT-NAME>RootComposition</SHORT-NAME>
              <SOFTWARE-COMPOSITION-TREF DEST="COMPOSITION-SW-COMPONENT-TYPE">/Application/ReferenceComposition</SOFTWARE-COMPOSITION-TREF>
            </ROOT-SW-COMPOSITION-PROTOTYPE>
          </ROOT-SOFTWARE-COMPOSITIONS>
        </SYSTEM>
      </ELEMENTS>
    </AR-PACKAGE>
  </AR-PACKAGES>
</AUTOSAR>
