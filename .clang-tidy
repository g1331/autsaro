# C coding standard checks (docs/development/c-coding-standard.md). The version is pinned in
# pyproject.toml; `quality --c-samples` runs it over generated samples against a baseline.
#
# Disabled with reason:
# - easily-swappable-parameters: standard AUTOSAR signatures fix parameter order.
# - branch-clone: MISRA 15.7 requires a terminating else, and the project documents each
#   deliberately empty guard branch; together they make empty branch bodies identical.
# - optin.performance.Padding: field order follows meaning and the published layout.
Checks: >
  -*,
  clang-analyzer-*,
  -clang-analyzer-optin.performance.Padding,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-branch-clone,
  readability-function-size,
  readability-braces-around-statements,
  readability-identifier-naming
HeaderFilterRegex: '.*'
ExcludeHeaderFilterRegex: '(^|/)(kernel|third_party)/'
CheckOptions:
  readability-function-size.LineThreshold: 60
  # Feature-test macros select POSIX declarations before any system header.
  bugprone-reserved-identifier.AllowedIdentifiers: '_GNU_SOURCE;_XOPEN_SOURCE;_POSIX_C_SOURCE'
  # Each *IgnoredRegexp matches the whole name. Upper-case forms are AUTOSAR names:
  # <Mip>_<Sn> functions and SchM/Rte macros, <Mip>_<Vn> globals, camel-case SWS parameters
  # and members, OS service and error macros, and FreeRTOS configuration names.
  readability-identifier-naming.MacroDefinitionCase: UPPER_CASE
  # The configured RTE section prefix is case-sensitive (SWS_MemMap_00022).
  readability-identifier-naming.MacroDefinitionIgnoredRegexp: '((Rte|SchM)_|OSServiceId_|OSError_|Declare[A-Z]|config[A-Z]|INCLUDE_|trace[A-Z]).*|RTE_Rte_(START|STOP)_SEC_CODE|OSErrorGetServiceId|TotalNumberOfCores|_[A-Z]+_SOURCE'
  readability-identifier-naming.EnumConstantCase: UPPER_CASE
  readability-identifier-naming.TypedefSuffix: Type
  readability-identifier-naming.TypedefIgnoredRegexp: 'boolean|u?int(8|16|32|64)(_least)?|sint(8|16|32|64)(_least)?|float(32|64)|BOOL|DWORD|HANDLE|U?LONG|ULONG_PTR|SIZE_T|CONTEXT|LP[A-Z_]+'
  readability-identifier-naming.FunctionCase: lower_case
  readability-identifier-naming.FunctionIgnoredRegexp: '[A-Z][A-Za-z0-9]*(_[A-Za-z0-9]+)*'
  readability-identifier-naming.GlobalVariableCase: lower_case
  readability-identifier-naming.GlobalVariableIgnoredRegexp: '[A-Z][A-Za-z0-9]*_[A-Za-z0-9]+'
  readability-identifier-naming.GlobalConstantCase: lower_case
  readability-identifier-naming.GlobalConstantIgnoredRegexp: '[A-Z][A-Za-z0-9]*_[A-Za-z0-9]+'
  readability-identifier-naming.LocalVariableCase: lower_case
  readability-identifier-naming.StaticVariableCase: lower_case
  readability-identifier-naming.ParameterCase: lower_case
  readability-identifier-naming.ParameterIgnoredRegexp: '[A-Za-z][A-Za-z0-9]*'
  readability-identifier-naming.MemberCase: lower_case
  readability-identifier-naming.MemberIgnoredRegexp: '[A-Za-z][A-Za-z0-9]*'
  readability-identifier-naming.StructCase: lower_case
  readability-identifier-naming.StructIgnoredRegexp: '[A-Z][A-Za-z0-9]*_[A-Za-z0-9]+'
  readability-identifier-naming.EnumCase: lower_case
  readability-identifier-naming.UnionCase: lower_case
