+
+/* Research-only queue transition; not a production API or complete finish hook. */
+void probe_requeue_current(void)
+{
+    taskENTER_CRITICAL();
+    (void)uxListRemove(&(pxCurrentTCB->xStateListItem));
+    prvAddTaskToReadyList(pxCurrentTCB);
+    portYIELD_WITHIN_API();
+    taskEXIT_CRITICAL();
+}
+
+/* Legal-path state-transition experiment only: no errors/hooks/ISR support. */
+void probe_transition(TaskHandle_t target, BaseType_t requeue)
+{
+    taskENTER_CRITICAL();
+    (void)uxListRemove(&(pxCurrentTCB->xStateListItem));
+    if(requeue) { prvAddTaskToReadyList(pxCurrentTCB); }
+    else { vListInsertEnd(&xSuspendedTaskList, &(pxCurrentTCB->xStateListItem)); }
+    if(target != NULL && target != pxCurrentTCB) { vTaskResume(target); }
+    portYIELD_WITHIN_API();
+    taskEXIT_CRITICAL();
+}
