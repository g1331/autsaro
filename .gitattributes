# Installer-managed upstream BMad skills are vendored without rewriting their content.
/.agents/skills/** -whitespace
# Preserve dependency and patch bytes for offline SHA-256 verification.
/third_party/freertos/** -text
# A unified patch uses a single space as the empty context-line marker.
/runtime/os/patches/** -text whitespace=-blank-at-eol
# Original input raw-byte manifests must survive a fresh checkout unchanged.
/core/tests/fixtures/epic4/** text eol=lf
/core/tests/fixtures/epic4_oracles/** text eol=lf
/docs/assurance/epic4/** text eol=lf
