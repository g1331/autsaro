# The vendored upstream impeccable skill keeps its original bytes.
/.agents/skills/impeccable/** -whitespace
# Preserve dependency and patch bytes for offline SHA-256 verification.
/third_party/freertos/** -text
# A unified patch uses a single space as the empty context-line marker.
/runtime/os/** text eol=lf
/runtime/ecu/** text eol=lf
# The build-generated delivery inventory preserves this manifest formatting.
/runtime/contracts/** text eol=lf
/runtime/os/patches/** -text whitespace=-blank-at-eol
# Test fixtures are byte-exact inputs (raw-byte manifests, text patches); keep LF on every checkout.
/core/tests/fixtures/** text eol=lf
# Built-in project templates are embedded and must not depend on checkout line endings.
/core/resources/** text eol=lf

# Delivered license texts keep fixed checkout bytes.
/LICENSE text eol=lf
/NOTICE text eol=lf

# Packaged stdlib tools and embedded delivery text have fixed raw-byte digests.
/tools/python/src/ecu_tools/** text eol=lf
/runtime/ecu-tool.py text eol=lf

# Mainline BSW sources and host adapters keep reproducible LF bytes.
/runtime/bsw/** text eol=lf
/runtime/host/** text eol=lf
# These BSW and host adapter files keep reproducible CRLF checkout bytes.
/runtime/bsw/include/Can_GeneralTypes.h text eol=crlf
/runtime/bsw/include/SchM_Can.h text eol=crlf
/runtime/bsw/src/Can.c text eol=crlf
/runtime/host/include/Ecu_Status.h text eol=crlf
/runtime/host/src/Can_HostLock.c text eol=crlf
/runtime/host/src/Can_HostLock.h text eol=crlf

# Fuzz corpus and reproducers are byte-exact inputs.
/fuzz/corpus/** -text
/fuzz/regressions/** -text

# Generated IPC declarations are compared byte-for-byte on both desktop platforms.
/ui/src/ipc/bindings*.ts text eol=lf
