/** @file
 * @brief Generated component contract; runtime implementation is separate.
 */
#ifndef RTE_H
#define RTE_H
#include "Rte_Version.h"

#include "Rte_Cfg.h"
#include "Std_Types.h"
/* SWS_BSW_00036: imported AUTOSAR major/minor release. */
#if !defined(STD_TYPES_AR_RELEASE_MAJOR_VERSION) || !defined(STD_TYPES_AR_RELEASE_MINOR_VERSION)
#error "Rte.h -> Std_Types.h: missing AUTOSAR release"
#elif (STD_TYPES_AR_RELEASE_MAJOR_VERSION != 4U) || (STD_TYPES_AR_RELEASE_MINOR_VERSION != 10U)
#error "Rte.h -> Std_Types.h: incompatible AUTOSAR release"
#endif
#include "ComStack_Types.h"
/* SWS_BSW_00036: imported AUTOSAR major/minor release. */
#if !defined(COMSTACKTYPE_AR_RELEASE_MAJOR_VERSION) ||                                             \
    !defined(COMSTACKTYPE_AR_RELEASE_MINOR_VERSION)
#error "Rte.h -> ComStack_Types.h: missing AUTOSAR release"
#elif (COMSTACKTYPE_AR_RELEASE_MAJOR_VERSION != 4U) ||                                             \
    (COMSTACKTYPE_AR_RELEASE_MINOR_VERSION != 10U)
#error "Rte.h -> ComStack_Types.h: incompatible AUTOSAR release"
#endif

/** Standard RTE and SchM statuses (SWS_Rte_07712/07713). */
@STATUSES@
/** Test the infrastructure bit (SWS_Rte_07404); the argument is evaluated once.
 * @param[in] status An RTE status value; evaluated once.
 * @return TRUE if the infrastructure bit is set.
 * Preconditions: None.
 * Context: any context, including inside exclusive areas.
 * Reentrancy: reentrant; no state is accessed.
 * Ownership: no storage is borrowed or retained.
 */
#define Rte_IsInfrastructureError(status) (((status) & 128U) != 0U)
/** Test the overlay bit (SWS_Rte_07405); the argument is evaluated once.
 * @param[in] status An RTE status value; evaluated once.
 * @return TRUE if the overlay bit is set.
 * Preconditions: None.
 * Context: any context, including inside exclusive areas.
 * Reentrancy: reentrant; no state is accessed.
 * Ownership: no storage is borrowed or retained.
 */
#define Rte_HasOverlayedError(status) (((status) & 64U) != 0U)
/** Read the application error (SWS_Rte_07406); the argument is evaluated once.
 * @param[in] status An RTE status value; evaluated once.
 * @return The lower six bits of the status.
 * Preconditions: None.
 * Context: any context, including inside exclusive areas.
 * Reentrancy: reentrant; no state is accessed.
 * Ownership: no storage is borrowed or retained.
 */
#define Rte_ApplicationError(status) ((status) & 63U)
#include "Rte_Main.h"

#endif
