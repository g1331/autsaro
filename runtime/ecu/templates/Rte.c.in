#include "Ecu_Target.h"
#include "Ecu_TargetConfig.h"
#include "Com.h"
#include "Can.h"
#include "@APP_HEADER@"
#include "@CLIENT_HEADER@"
#include <string.h>

static int available(void) {
    Can_ControllerStateType mode;
    return (Ecu_TargetIsOwner() != 0) && (Can_GetControllerMode(0u, &mode) == E_OK) &&
           (mode == CAN_CS_STARTED);
}
Std_ReturnType Com_SendSignal(Com_SignalIdType SignalId, const void *SignalDataPtr) {
    uint32 value;
    if ((available() == 0) || (SignalDataPtr == NULL) || (SignalId != @TX_ID@u)) {
        return COM_SERVICE_NOT_AVAILABLE;
    }
    (void)memcpy(&value, SignalDataPtr, sizeof(value));
    return (Com_SetSignal(SignalId, value) == ECU_OK) ? E_OK : COM_SERVICE_NOT_AVAILABLE;
}
Std_ReturnType Com_ReceiveSignal(Com_SignalIdType SignalId, void *SignalDataPtr) {
    uint32 value;
    uint8_t valid;
    if ((available() == 0) || (SignalDataPtr == NULL) || (SignalId != @RX_ID@u)) {
        return COM_SERVICE_NOT_AVAILABLE;
    }
    if (Com_GetSignal(SignalId, &value, &valid) != ECU_OK) {
        return COM_SERVICE_NOT_AVAILABLE;
    }
    /* Com preserves the received value when its deadline clears validity.
     * Return that value unchanged; Rte_Read reports freshness separately. */
    (void)memcpy(SignalDataPtr, &value, sizeof(value));
    return E_OK;
}
Std_ReturnType @READ_API@(uint32 *data) {
    if (Com_ReceiveSignal(@RX_ID@u, data) != E_OK) {
        return RTE_E_COM_STOPPED;
    }
    return Ecu_TargetReceiveStatus();
}
Std_ReturnType @WRITE_API@(uint32 data) { return Com_SendSignal(@TX_ID@u, &data); }
Std_ReturnType @CALL_API@(@DATATYPE@ Data) {
    if ((available() == 0) || (Data == NULL)) {
        return E_NOT_OK;
    }
    return @SERVER_API@(Data);
}
Std_ReturnType @CLIENT_API@(@DATATYPE@ Data) {
    return @CALL_API@(Data);
}
Std_ReturnType Ecu_TargetReadDid(uint8_t *data) { return @CLIENT_API@(data); }
uint8_t Ecu_TargetInitializeRte(void) {
    Ecu_TargetAssertOwner();
    Ecu_ApplicationInitialize();
    return (Com_SetSignal(@TX_ID@u, @TX_INITIAL@u) == ECU_OK) ? E_OK : E_NOT_OK;
}
