#include "Ecu_Target.h"
#include "Ecu_TargetConfig.h"
#include "Ecu_Config.h"
#include "Os_Mailbox.h"

#define OS_START_SEC_CODE
#include "Os_MemMap.h"
@TASK@
#define OS_STOP_SEC_CODE
#include "Os_MemMap.h"
#define OS_START_SEC_CONFIG_DATA_PREBUILD_8
#include "Os_MemMap.h"
OS_MEMMAP static const uint8 task_name[] = @TASK_NAME@;
#define OS_STOP_SEC_CONFIG_DATA_PREBUILD_8
#include "Os_MemMap.h"
#define OS_START_SEC_CONFIG_DATA_PREBUILD_64
#include "Os_MemMap.h"
OS_MEMMAP static const Os_TaskConfigType tasks[] = {
    {
        .id = @TASK_SYMBOL@,
        .name = task_name,
        .entry = &OS_TASK_ENTRY(@TASK_SYMBOL@),
        .priority = @TASK_PRIORITY@u,
        .autostart_modes = 1u,
        .kind = OS_EXTENDED_TASK,
        .activation_limit = 1u,
        .schedule = OS_SCHEDULE_FULL,
        .internal_resource = 0u,
    },
};
OS_MEMMAP static const Os_CounterConfigType counters[] = {
    {
        .id = @COUNTER_SYMBOL@,
        .maximum = @COUNTER_MAX@u,
        .ticks_per_base = @COUNTER_BASE@u,
        .minimum_cycle = @COUNTER_MIN_CYCLE@u,
        .software = 1u,
    },
};
@OS_OBJECTS@
OS_MEMMAP static const Os_HookConfigType hooks = {
    .error = &ErrorHook,
    .pre_task = &PreTaskHook,
    .post_task = &PostTaskHook,
};
OS_MEMMAP static const Os_TimeConfigType time_config = {
    .counters = counters,
    .counter_count = 1u,
    .alarms = @ALARM_PTR@,
    .alarm_count = @ALARM_COUNT@u,
    .system_counter = @COUNTER_SYMBOL@,
    .owner = @TASK_SYMBOL@,
    .wake_event = ECU_TARGET_EVENT_WORK,
    .error_hook = NULL,
    .schedule_tables = @SCHEDULE_PTR@,
    .schedule_table_count = @SCHEDULE_COUNT@u,
};
OS_MEMMAP static const Os_IsrConfigType interrupts = {
    .priorities = {[OS_INPUT_INTERRUPT] = 1u},
};
OS_MEMMAP const Os_TargetConfigType Ecu_OsConfig = {
    .tasks = tasks,
    .task_count = 1u,
    .host_stack_reserve = 262144u,
    .resources = @RESOURCE_PTR@,
    .resource_count = @RESOURCE_COUNT@u,
    .internal_resources = NULL,
    .internal_resource_count = 0u,
    .category1_isrs = 0u,
    .input_task = @TASK_SYMBOL@,
    .input_event = ECU_TARGET_EVENT_IO,
    .time = &time_config,
    .hooks = &hooks,
    .interrupts = &interrupts,
    .use_res_scheduler = @USE_RES_SCHEDULER@u,
};

#define OS_STOP_SEC_CONFIG_DATA_PREBUILD_64
#include "Os_MemMap.h"
