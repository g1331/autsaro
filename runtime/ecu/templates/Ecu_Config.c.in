    .frames = frames,
    .frame_count = 2u,
    .signals = signals,
    .signal_count = 2u,
    .diagnostic = &diagnostic,
};

static const uint8_t allowed_sids[] = {0x10u, 0x3eu, 0x22u};
const EcuPolicyConfig Ecu_Policy = {
    .tx_confirmation = ECU_TX_QUEUED,
    .rx_time_order = ECU_RX_BEFORE_DEADLINE,
    .tx_padding_dlc = 8u,
    .wft_max = 0u,
    .wait_when_wft_max_zero = ECU_WAIT_ABORT,
    .max_read_dids = 2u,
    .read_did_sessions = @READ_DID_SESSIONS@u,
    .allowed_sids = allowed_sids,
    .allowed_sid_count = sizeof(allowed_sids) / sizeof(allowed_sids[0]),
