    Ecu_TargetTask();
}
#define OS_STOP_SEC_CODE
#include "Os_MemMap.h"
static const Os_TaskConfig tasks[] = {
    {
        .id = @TASK_SYMBOL@,
        .name = @TASK_NAME@,
