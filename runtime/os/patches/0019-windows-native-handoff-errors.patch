+/* Native ownership and handoff failures stop the OS before protected state is used. */
+static void prvWaitForObject( HANDLE xObject )
+{
+    configASSERT( WaitForSingleObject( xObject, INFINITE ) == WAIT_OBJECT_0 );
+}
+
+static void prvReleaseMutex( HANDLE xMutex )
+{
+    configASSERT( ReleaseMutex( xMutex ) != 0 );
+}
+
+static void prvSignalEvent( HANDLE xEvent )
+{
+    configASSERT( Os_HostSetEvent( xEvent ) != 0 );
+}
+
+static void prvResetEvent( HANDLE xEvent )
+{
+    configASSERT( ResetEvent( xEvent ) != 0 );
+}
