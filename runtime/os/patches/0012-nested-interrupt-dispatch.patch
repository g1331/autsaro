+/* These routines execute only on the existing native ISR actor while it owns
+ * the interrupt mutex. Callback nesting is bounded by strictly increasing
+ * configured priorities; no new task selector or automotive actor is used. */
+static uint32_t prvRunOsInterrupt( uint32_t interrupt )
+{
+    uint32_t requested = 0U;
+    ulPendingInterrupts &= ~( UINT32_C( 1 ) << interrupt );
+    if( ulIsrHandler[ interrupt ] != NULL )
+    {
+        Os_StackCheck();
+        Os_BackendInterruptEnter( interrupt );
+        requested = ulIsrHandler[ interrupt ]();
+        Os_StackCheck();
+        Os_BackendInterruptLeave();
+    }
+    return requested;
+}
+
+static uint32_t prvNextOsInterrupt( uint32_t seen, unsigned floor, int nested )
+{
+    uint32_t chosen = portMAX_INTERRUPTS;
+    unsigned highest = floor;
+    uint32_t interrupt;
+    for( interrupt = 0U; interrupt < portMAX_INTERRUPTS; ++interrupt )
+    {
+        const uint32_t bit = UINT32_C( 1 ) << interrupt;
+        const unsigned priority = Os_BackendInterruptPriority( interrupt );
+        if( ( ( ulPendingInterrupts & ~seen & bit ) != 0U ) &&
+            Os_BackendInterruptEnabled( interrupt ) )
+        {
+            /* The kernel yield handshake precedes application dispatch only
+             * at the outer boundary; it never interrupts an application ISR. */
+            if( ( nested == 0 ) && ( interrupt == portINTERRUPT_YIELD ) )
+            {
+                return interrupt;
+            }
+            if( priority > highest )
+            {
+                chosen = interrupt;
+                highest = priority;
+            }
+        }
+    }
+    return chosen;
+}
+
+void Os_PortDispatchNested( void )
+{
+    const Os_NativeStack * stack = Os_StackCurrent();
+    const unsigned current = Os_BackendCurrentInterrupt();
+    uint32_t seen = 0U;
+    if( ( stack != NULL ) && ( stack->role == 'S' ) &&
+        ( current < portMAX_INTERRUPTS ) &&
+        ( current != portINTERRUPT_YIELD ) &&
+        ( ulCriticalNesting == portNO_CRITICAL_NESTING ) )
+    {
+        uint32_t interrupt = prvNextOsInterrupt( seen, Os_BackendInterruptPriority( current ), 1 );
+        while( interrupt < portMAX_INTERRUPTS )
+        {
+            const uint32_t requested = prvRunOsInterrupt( interrupt );
+            seen |= UINT32_C( 1 ) << interrupt;
+            if( ( requested != 0U ) && Os_BackendInterruptMaySchedule( interrupt ) )
+            {
+                Os_BackendRequestIsrReschedule();
+            }
+            interrupt = prvNextOsInterrupt( seen, Os_BackendInterruptPriority( current ), 1 );
+        }
+    }
+}
