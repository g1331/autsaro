+static uint32_t next_interrupt(uint32_t seen, unsigned floor, int nested)
+{
+    uint32_t chosen = PORT_INTERRUPT_COUNT;
+    unsigned priority = floor;
+    uint32_t index;
+    for (index = 0u; index < PORT_INTERRUPT_COUNT; ++index) {
+        const uint32_t bit = UINT32_C(1) << index;
+        const unsigned candidate = Os_BackendInterruptPriority(index);
+        if ((pending & ~seen & bit) != 0u && Os_BackendInterruptEnabled(index) != 0) {
+            if (nested == 0 && index == portINTERRUPT_YIELD) {
+                return index;
+            }
+            if (candidate > priority) {
+                chosen = index;
+                priority = candidate;
+            }
+        }
+    }
+    return chosen;
 }
