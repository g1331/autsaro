+void Os_PortDispatchNested(void)
+{
+    const Os_NativeStack *stack = Os_StackCurrent();
+    const unsigned outer = Os_BackendCurrentInterrupt();
+    uint32_t seen = 0u;
+    if (stack != NULL && stack->role == 'S' && outer < PORT_INTERRUPT_COUNT &&
+        outer != portINTERRUPT_YIELD && critical_nesting == 0u) {
+        uint32_t interrupt = next_interrupt(seen, Os_BackendInterruptPriority(outer), 1);
+        while (interrupt < PORT_INTERRUPT_COUNT) {
+            const uint32_t requested = run_interrupt(interrupt);
+            seen |= UINT32_C(1) << interrupt;
+            if (requested != 0u && Os_BackendInterruptMaySchedule(interrupt) != 0) {
+                Os_BackendRequestIsrReschedule();
+            }
+            interrupt = next_interrupt(seen, Os_BackendInterruptPriority(outer), 1);
+        }
     }
