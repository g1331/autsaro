+/* Only this kernel ready list selects runnable tasks. The backend supplies the
+ * identity of the oldest accepted request, never a selected runnable task. */
+STATIC void prvOsInsertReadyTask( TCB_t * pxTask )
+{
+    List_t * pxReady = &( pxReadyTasksLists[ pxTask->uxPriority ] );
+    ListItem_t * pxPosition = listGET_HEAD_ENTRY( pxReady );
+    ListItem_t * pxPreviousIndex = pxReady->pxIndex;
+    while( pxPosition != listGET_END_MARKER( pxReady ) )
+    {
+        const TCB_t * pxOther = listGET_LIST_ITEM_OWNER( pxPosition );
+        if( pxOther->ullOsReadySequence > pxTask->ullOsReadySequence )
+        {
+            break;
+        }
+        pxPosition = listGET_NEXT( pxPosition );
+    }
+    /* vListInsertEnd inserts before pxIndex. Restore that cursor immediately;
+     * the fixed FIFO selector observes the list head, not the rotating cursor. */
+    pxReady->pxIndex = pxPosition;
+    vListInsertEnd( pxReady, &( pxTask->xStateListItem ) );
+    pxReady->pxIndex = pxPreviousIndex;
+}
+
+void vTaskOsSetReadySequence( TaskHandle_t xTask, uint64_t ullSequence )
+{
+    TCB_t * pxTask = xTask;
+    configASSERT( pxTask != NULL );
+    taskENTER_CRITICAL();
+    {
+        pxTask->ullOsReadySequence = ullSequence;
+        if( listLIST_ITEM_CONTAINER( &( pxTask->xStateListItem ) ) ==
+            &( pxReadyTasksLists[ pxTask->uxPriority ] ) )
+        {
+            ( void ) uxListRemove( &( pxTask->xStateListItem ) );
+            prvOsInsertReadyTask( pxTask );
+        }
+    }
+    taskEXIT_CRITICAL();
+}
+
+uint64_t ullTaskOsReadySequence( TaskHandle_t xTask )
+{
+    uint64_t ullSequence;
+    const TCB_t * pxTask = xTask;
+    configASSERT( pxTask != NULL );
+    taskENTER_CRITICAL();
+    ullSequence = pxTask->ullOsReadySequence;
+    taskEXIT_CRITICAL();
+    return ullSequence;
+}
